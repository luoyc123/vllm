# 必填：模型本地路径或 Hugging Face ID。正式 baseline 建议换成单卡放不下、双卡可容纳的模型。
MODEL=/path/to/model

# 推荐租机后创建隔离环境，不要复用机器的全局 Python。
VLLM_ENV=/home/arden/HXinfer/.venv

HOST=127.0.0.1
PORT=8000
PIPELINE_PARALLEL_SIZE=2
TENSOR_PARALLEL_SIZE=1
# Complete activation data plane: tcp (default) or gloo.
HXINFER_ACTIVATION_BACKEND=tcp
GPU_MEMORY_UTILIZATION=0.90
DTYPE=auto
MAX_MODEL_LEN=4096

# benchmark 参数。固定 seed 和输入规模，保证 A/B/C 可比较。
NUM_PROMPTS=32
RANDOM_INPUT_LEN=512
RANDOM_OUTPUT_LEN=128
REQUEST_RATE=inf
SEED=20260823

# 可追加 vllm serve 参数，例如量化或 trust-remote-code。
EXTRA_SERVE_ARGS=

# External PP smoke test。当前实现限定同机 PP=2/TP=1，stage 数据不走 NCCL。
SMOKE_MAX_TOKENS=16
# HXINFER_SOCKET_PATH 留空时由 run_external_pp.sh 为每次运行生成唯一地址。
